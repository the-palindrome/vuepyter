{
  "name": "vuepyter",
  "version": "0.1.0",
  "description": "A lightweight Jupyter Notebook editor for Vue",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/vuepyter.css",
    "./dist/vuepyter.css": "./dist/vuepyter.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "node ./scripts/prepare-package.mjs",
    "dev": "vite",
    "test": "vitest run --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "e2e:dev": "vite tests/e2e --config vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "test:watch": "vitest --maxWorkers=1",
    "typecheck": "vue-tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "lint:pkg": "publint",
    "lint:types": "attw --pack . --exclude-entrypoints ./style.css ./dist/vuepyter.css",
    "release:check": "npm run typecheck && npm test && npm run build && npm run pack:check && npm run lint:pkg && npm run lint:types",
    "release:version": "changelogen --release && bumpp package.json"
  },
  "keywords": [
    "vue",
    "jupyter",
    "notebook",
    "pyodide"
  ],
  "author": "the-palindrome",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-palindrome/vuepyter.git"
  },
  "homepage": "https://github.com/the-palindrome/vuepyter#readme",
  "bugs": {
    "url": "https://github.com/the-palindrome/vuepyter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.9.1",
    "@codemirror/lang-markdown": "^6.4.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.3",
    "katex": "^0.16.45",
    "lucide-vue-next": "^1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "bumpp": "^10.2.3",
    "changelogen": "^0.6.2",
    "jsdom": "^26.1.0",
    "publint": "^0.3.15",
    "typescript": "^5.8.3",
    "vite": "^7.1.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.1.1"
  }
}
